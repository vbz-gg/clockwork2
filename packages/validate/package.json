{
  "name": "@clockwork2/validate",
  "version": "0.1.0",
  "description": "The Clockwork 2 conformance suite and its CLI",
  "license": "MIT",
  "author": "Ramesh Nair",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbz-gg/clockwork2.git",
    "directory": "packages/validate"
  },
  "type": "module",
  "sideEffects": false,
