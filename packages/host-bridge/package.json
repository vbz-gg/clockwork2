{
  "name": "@clockwork2/host-bridge",
  "version": "0.1.0",
  "description": "Host loop, input capture and the iframe and worker protocol",
  "license": "MIT",
  "author": "Ramesh Nair",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbz-gg/clockwork2.git",
    "directory": "packages/host-bridge"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parent": {
      "development": "./src/parent/index.ts",
      "types": "./dist/parent/index.d.ts",
      "default": "./dist/parent/index.js"
    },
    "./frame": {
      "development": "./src/frame/index.ts",
      "types": "./dist/frame/index.d.ts",
      "default": "./dist/frame/index.js"
    },
    "./worker": {
      "development": "./src/worker/index.ts",
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./protocol": {
      "development": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@clockwork2/kernel": "workspace:*"
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}
