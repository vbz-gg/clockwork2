{
  "packageFiles": ["package.json"],
  "bumpFiles": [
    "package.json",
    "packages/engine/package.json",
    {
      "filename": "packages/engine/src/index.ts",
      "updater": "scripts/kernel-version-updater.cjs"
    }
  ],
  "infile": "CHANGELOG.md",
  "tagPrefix": "v",
  "scripts": {
    "prerelease": "bun run lint && bun run build && bun run typecheck && bun run test:coverage && bun run scripts/lint-sim-purity.ts && bun run test:engines && bun run scripts/check-publishable.ts"
  },
  "types": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "build",
      "section": "Build System"
    },
    {
      "type": "ci",
      "section": "CI"
    },
    {
      "type": "chore",
      "hidden": true
    },
    {
      "type": "style",
      "hidden": true
    }
  ]
}
